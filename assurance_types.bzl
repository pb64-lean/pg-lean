PG_SASL_PRINCIPAL_TYPES = {
    "Pg.Sasl.Scram.clientFirst_message": "∀ (binding : Pg.Sasl.Scram.ChannelBinding) (user password nonce : String), (Pg.Sasl.Scram.clientFirstWithChannelBinding binding user password nonce).snd = binding.gs2Header ++ (\"n=\" ++ Pg.Sasl.Scram.saslName user ++ \",r=\" ++ nonce)",
    "Pg.Sasl.Scram.clientFirst_state": "∀ (binding : Pg.Sasl.Scram.ChannelBinding) (user password nonce : String), (Pg.Sasl.Scram.clientFirstWithChannelBinding binding user password nonce).fst = { password := password, nonce := nonce, clientFirstBare := \"n=\" ++ Pg.Sasl.Scram.saslName user ++ \",r=\" ++ nonce, channelBinding := binding, phase := Pg.Sasl.Scram.Phase.sentFirst }",
    "Pg.Sasl.Scram.parseServerFirst_spec": "∀ {ourNonce msg : String} {sf : Pg.Sasl.Scram.ServerFirst}, Pg.Sasl.Scram.parseServerFirst ourNonce msg = Except.ok sf → sf.nonce.startsWith ourNonce = true ∧ 0 < sf.iterations ∧ sf.iterations ≤ Pg.Sasl.Scram.maxIterations ∧ ∃ r s i rest, Pg.Sasl.Scram.splitOnChar ',' msg = r :: s :: i :: rest ∧ r.startsWith \"r=\" = true ∧ s.startsWith \"s=\" = true ∧ i.startsWith \"i=\" = true ∧ sf.nonce = Pg.Sasl.Scram.valueAfterPrefix r ∧ Pg.Crypto.Base64.decode? (Pg.Sasl.Scram.valueAfterPrefix s) = some sf.salt ∧ (Pg.Sasl.Scram.valueAfterPrefix i).toNat? = some sf.iterations",
    "Pg.Sasl.Scram.parseServerFirst_nonce_extends": "∀ {ourNonce msg : String} {sf : Pg.Sasl.Scram.ServerFirst}, Pg.Sasl.Scram.parseServerFirst ourNonce msg = Except.ok sf → sf.nonce.startsWith ourNonce = true",
    "Pg.Sasl.Scram.parseServerFirst_render": "∀ {ourNonce nonce salt64 iters : String} {salt : ByteArray} {iterations : Nat}, ¬',' ∈ nonce.toList → ¬',' ∈ salt64.toList → ¬',' ∈ iters.toList → nonce.startsWith ourNonce = true → Pg.Crypto.Base64.decode? salt64 = some salt → iters.toNat? = some iterations → 0 < iterations → iterations ≤ Pg.Sasl.Scram.maxIterations → Pg.Sasl.Scram.parseServerFirst ourNonce (Pg.Sasl.Scram.renderServerFirst nonce salt64 iters) = Except.ok { nonce := nonce, salt := salt, iterations := iterations }",
    "Pg.Sasl.Scram.clientFinal_spec": "∀ {c : Pg.Sasl.Scram.Client} {serverFirst : String} {c' : Pg.Sasl.Scram.Client} {final : String}, c.phase = Pg.Sasl.Scram.Phase.sentFirst → Pg.Sasl.Scram.clientFinal c serverFirst = Except.ok (c', final) → ∃ sf, Pg.Sasl.Scram.parseServerFirst c.nonce serverFirst = Except.ok sf ∧ final = \"c=\" ++ c.channelBinding.encoded ++ \",r=\" ++ sf.nonce ++ \",p=\" ++ Pg.Crypto.Base64.encode (Pg.Sasl.Scram.xorBytes (Pg.Crypto.hmacSha256 (Pg.Crypto.pbkdf2HmacSha256 c.password.toUTF8 sf.salt sf.iterations) \"Client Key\".toUTF8) (Pg.Crypto.hmacSha256 (Pg.Crypto.sha256 (Pg.Crypto.hmacSha256 (Pg.Crypto.pbkdf2HmacSha256 c.password.toUTF8 sf.salt sf.iterations) \"Client Key\".toUTF8)) (c.clientFirstBare ++ \",\" ++ serverFirst ++ \",\" ++ (\"c=\" ++ c.channelBinding.encoded ++ \",r=\" ++ sf.nonce)).toUTF8)) ∧ c'.phase = Pg.Sasl.Scram.Phase.sentFinal (Pg.Crypto.hmacSha256 (Pg.Crypto.hmacSha256 (Pg.Crypto.pbkdf2HmacSha256 c.password.toUTF8 sf.salt sf.iterations) \"Server Key\".toUTF8) (c.clientFirstBare ++ \",\" ++ serverFirst ++ \",\" ++ (\"c=\" ++ c.channelBinding.encoded ++ \",r=\" ++ sf.nonce)).toUTF8) ∧ c'.password = c.password ∧ c'.nonce = c.nonce ∧ c'.clientFirstBare = c.clientFirstBare",
    "Pg.Sasl.Scram.verifyServerFinal_spec": "∀ {c : Pg.Sasl.Scram.Client} {serverFinal : String}, Pg.Sasl.Scram.verifyServerFinal c serverFinal = Except.ok () → ∃ expected first rest, c.phase = Pg.Sasl.Scram.Phase.sentFinal expected ∧ Pg.Sasl.Scram.splitOnChar ',' serverFinal = first :: rest ∧ first.startsWith \"v=\" = true ∧ Pg.Crypto.Base64.decode? (Pg.Sasl.Scram.valueAfterPrefix first) = some expected",
}

