package(default_visibility = ["//visibility:public"])

load("@rules_lean//lean:defs.bzl", "lean_assurance_test", "lean_library")
load("//:assurance.bzl", "PG_ALLOWED_AXIOMS")

# OIDs and text/binary codecs (PgNumeric, PgInterval, Std.Time mappings).
lean_library(
    name = "types",
    srcs = [
        "Codec.lean",
        "Digits.lean",
        "Interval.lean",
        "Numeric.lean",
        "Oid.lean",
    ],
    deps = [
        "//Pg/Crypto:crypto",
        "//Pg/Protocol:protocol",
    ],
)

# Compile-time audit of the value codecs. The principal theorems are the
# roundtrips: whatever the client encodes for a parameter, the decoder for that
# type reads back as the same value. Silent precision loss in `numeric` or a
# mis-shifted epoch in a timestamp is exactly the class of bug these rule out.
lean_assurance_test(
    name = "types_assurance",
    allowed_axioms = PG_ALLOWED_AXIOMS,
    allowed_extern_modules = [],
    module_prefixes = ["Pg"],
    principal_theorems = [
        # Text-format parameters: the wire spelling decodes to the value sent.
        "Pg.decodeValue_text",
        "Pg.decode_encode_int2",
        "Pg.decode_encode_int4",
        "Pg.decode_encode_int8",
        "Pg.decode_encode_int",
        "Pg.decode_encode_bool",
        "Pg.decode_encode_text",
        "Pg.decode_encode_uuid",
        "Pg.decode_encode_bytea",
        # Big-endian binary integers: the readers invert the writers.
        "Pg.rdInt16_putUInt16",
        "Pg.rdInt32_putInt32",
        "Pg.rdInt64_putInt64BE",
        "Pg.rdUInt64_putInt64BE",
        "Pg.rdIntAny_putUInt16",
        "Pg.rdIntAny_putInt32",
        "Pg.rdIntAny_putInt64BE",
        "Pg.PgInterval.fromBinary_toBinary",
        # numeric: no precision is lost in the base-10000 binary form.
        "Pg.PgNumeric.fromBinary_toBinary",
        "Pg.PgNumeric.fromBinary_toBinary_special",
        "Pg.readNumericDigits_putUInt16s",
        "Pg.getUInt16?_putUInt16s",
        # Decimal fields: what the renderer wrote is what the parser reads.
        "Pg.natOfDigits_padDigits",
        "Pg.parseNatField_padDigits",
        # Temporal text: date, time-of-day, and the timestamp split.
        "Pg.dateFields_renderDate",
        "Pg.parseDate_renderDate",
        "Pg.parseTimeNanos_renderTimeNanos",
        "Pg.timestampFields_renderTimestamp",
        # 1-D arrays, NULLs and quoting included.
        "Pg.parseArrayText_renderArrayText",
        "Pg.decode_encode_array",
        "Pg.arrayScan_elem",
        "Pg.arrayScan_quoted",
    ],
    deps = [":types"],
)
